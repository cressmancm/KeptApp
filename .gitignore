# Build output: SwiftPM, the bundled Python environment, signed app, release zips
.build/
dist/
*.app

# Generated by build.sh on every build
app/LICENSES.txt

# Crash logs osxphotos writes into its working folder
osxphotos_crash.log

# macOS and local tool settings; Xcode writes .swiftpm/ when it opens the package
.DS_Store
.claude/settings.local.json
.swiftpm/
xcuserdata/

# Design handoff from the design tool: kept locally, not published. Its
# support.js is the tool's generated runtime, which isn't ours to license.
design_handoff_kept_onboarding_and_polish/

# Provisioning profiles: each maintainer downloads their own
*.provisionprofile

# Each developer's own signing settings for the Xcode project (see
# app/Signing.local.xcconfig.example)
Signing.local.xcconfig
