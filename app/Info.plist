<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Kept</string>
    <key>CFBundleDisplayName</key>
    <string>Kept</string>
    <!-- com.chip.PhotoBackup until 2026-08-13, then com.chip.Kept, then on
         2026-10-09 com.chipcressman.Kept: a domain the developer owns, chosen
         before the identifier was registered with Apple. The TCC grants, the
         login item, the daily check, the keychain key and the UserDefaults
         domain are all keyed to it, so each change costs a round of setup
         (IdentityMigration.swift carries the rest over). Registered now, so
         there is no reason left to change it. -->
    <key>CFBundleIdentifier</key>
    <string>com.chipcressman.Kept</string>
    <key>CFBundleExecutable</key>
    <string>Kept</string>
    <!-- Built from icon/kept-default.svg by make-icon.sh. LSUIElement means no
         Dock icon, but this is still what Finder, Get Info, System Settings →
         Login Items, and notification banners show. -->
    <key>CFBundleIconFile</key>
    <string>Kept</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.1</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <!-- macOS 26 and later, Apple silicon only. macOS 26 still runs on Intel
         Macs, but the bundled Python is arm64, so build.sh refuses any other
         architecture and Intel Macs can't run Kept. -->
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <!-- Menubar-only: no Dock icon, no app switcher entry -->
    <key>LSUIElement</key>
    <true/>
    <!-- Kept no longer asks for Photos access: the library is read as files,
         under Full Disk Access, and the narrower Photos grant has been
         unobtainable since the bundle identifier changed (self-signed, no
         Team ID). The key stays because the bundled osxphotos links Apple's
         Photos framework, and macOS terminates a process that touches PhotoKit
         without a usage description rather than merely denying it. -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Kept copies your library to a backup folder every night.</string>
    <!-- Shown in the Automation prompt. Reconnecting the NAS is an Apple Event
         (osascript `mount volume`), and macOS asks before allowing it. Kept
         raises that prompt when a share is chosen, while someone is there,
         rather than the first night the share drops. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Kept reconnects your backup drive when it's disconnected.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Chip Cressman</string>
</dict>
</plist>
