<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Kept</string>
    <key>CFBundleDisplayName</key>
    <string>Kept</string>
    <!-- com.chip.PhotoBackup until 2026-08-13, then com.chip.Kept, then on
         2026-10-09 com.chipcressman.Kept: a domain the developer owns, chosen
         before the identifier was registered with Apple. The TCC grants, the
         login item, the daily check, the keychain key and the UserDefaults
         domain are all keyed to it, so each change costs a round of setup
         (IdentityMigration.swift carries the rest over). Registered now, so
         there is no reason left to change it. -->
    <key>CFBundleIdentifier</key>
    <string>com.chipcressman.Kept</string>
    <key>CFBundleExecutable</key>
    <string>Kept</string>
    <!-- Built from icon/kept-default.svg by make-icon.sh. LSUIElement means no
         Dock icon, but this is still what Finder, Get Info, System Settings →
         Login Items, and notification banners show. -->
    <key>CFBundleIconFile</key>
    <string>Kept</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.4</string>
    <key>CFBundleVersion</key>
    <string>5</string>
    <!-- macOS 26 and later, Apple silicon only. macOS 26 still runs on Intel
         Macs, but the bundled Python is arm64, so build.sh refuses any other
         architecture and Intel Macs can't run Kept. -->
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <!-- Menubar-only: no Dock icon, no app switcher entry -->
    <key>LSUIElement</key>
    <true/>
    <!-- What macOS shows when Kept asks. Photos: Kept reads the library's
         files, which the Photos permission allows when it's Full Access (see
         app-entitlements.plist). The others are the places a backup folder
         can be: a NAS, an external drive, or a folder in Documents, Desktop,
         or Downloads. Kept asks for the backup folder's while you choose it,
         so the question never waits at 2 AM (DestinationPicker). -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Kept reads your library to copy it to your backup folder. It never changes or uploads your photos.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>Kept copies your photos to the backup folder on this network drive.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>Kept copies your photos to the backup folder on this drive.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Kept copies your photos to the backup folder in Documents.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>Kept copies your photos to the backup folder on the Desktop.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Kept copies your photos to the backup folder in Downloads.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Chip Cressman</string>
</dict>
</plist>
