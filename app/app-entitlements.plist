<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Swift app binary. Deliberately minimal: this file must
  NOT gain disable-library-validation. That relaxation belongs only on the
  bundled interpreter (see python-entitlements.plist); the app links nothing
  outside /System and /usr/lib and keeps library validation fully enforced.

  apple-events is load-bearing, not boilerplate. The destination is mounted by
  driving Finder with `osascript`, which is an Apple Event, and under the
  hardened runtime tccd refuses to even *prompt* for kTCCServiceAppleEvents
  when the sending process lacks this entitlement:

      Prompting policy for hardened runtime; service: kTCCServiceAppleEvents
      requires entitlement com.apple.security.automation.apple-events but it
      is missing

  Observed 2026-08-13, after the bundle identifier changed to com.chip.Kept.
  The old identifier had carried a stored AppleEvents grant since July, so it
  never had to ask again and this gap stayed invisible for weeks.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
